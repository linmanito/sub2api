# AWS EC2 部署配置示例
# 适用于 Ubuntu AMI 的快速配置模板
#
# 使用方法:
# 1. 复制此文件: cp deploy.config.aws.example deploy.config
# 2. 修改下面的配置为你的实际值
# 3. 运行部署: ./deploy.sh

# ============================================
# AWS EC2 服务器配置
# ============================================

# SSH 用户名（根据你的 AMI 选择）
# - Ubuntu: ubuntu
# - Amazon Linux: ec2-user
# - CentOS: centos
SERVER_USER="ubuntu"

# EC2 公有 IP 或公有 DNS
# 可以在 AWS 控制台 EC2 实例详情中找到
# 示例: 3.80.123.45 或 ec2-3-80-123-45.compute-1.amazonaws.com
SERVER_HOST="your-ec2-public-ip-or-dns"

# SSH 端口（通常不需要修改）
SERVER_PORT="22"

# ============================================
# SSH 密钥配置
# ============================================

# EC2 密钥文件路径（.pem 文件）
# 下载密钥后，建议移动到 ~/.ssh/ 目录
# 示例: /Users/yourname/.ssh/my-ec2-key.pem
SSH_KEY_FILE="~/.ssh/your-key.pem"

# ============================================
# 远程服务器路径配置
# ============================================

# 应用部署目录
REMOTE_DIR="/home/sub2api"

# systemd 服务名称
SERVICE_NAME="sub2api"

# ============================================
# 本地编译配置
# ============================================

# 编译后的二进制文件路径
LOCAL_BINARY="backend/bin/server"

# ============================================
# 备份配置
# ============================================

# 保留最近几个备份文件
KEEP_BACKUPS=5

# ============================================
# 配置完成后的操作
# ============================================
#
# 1. 确保密钥文件权限正确:
#    chmod 400 ~/.ssh/your-key.pem
#
# 2. 测试 SSH 连接:
#    ssh -i ~/.ssh/your-key.pem ubuntu@your-ec2-ip
#
# 3. 执行部署:
#    ./deploy.sh
#
# 4. 查看日志:
#    ssh -i ~/.ssh/your-key.pem ubuntu@your-ec2-ip "tail -f /home/sub2api/logs/sub2api.log"
